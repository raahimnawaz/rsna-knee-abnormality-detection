labeling/labeling_sample.csv
labeling/labeler.html

# Credentials must never land here (they live in ~/.kaggle/access_token)
*access_token*
kaggle.json

.venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Feature cache (~2.4 GB) and trained heads. Rebuilt by notebooks/kaggle_02 on Kaggle and
# fusion/train.py here; neither belongs in git.
data/features/
data/features_224/
data/nifti/
fusion/runs*/

# nnU-Net Gate 1 (PLAN C-4) -- separate env, nnunetv2 pulls its own deps
.venv_nnunet/
